<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="raiz" styleClass="raiz" stylesheets="@css/estilos.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="es.medac.espejo.tunel.SalaController">

    <!-- Capa de viñeta roja progresiva cuando el cursor sale del objetivo -->
    <Region fx:id="capaAlertaRoja" styleClass="alerta-roja" mouseTransparent="true" opacity="0.0"/>

    <!-- Capa de interacción y acertijo -->
    <VBox alignment="CENTER" spacing="25">
        <Label text="Mírate..." styleClass="titulo"/>

        <!-- Conjunto ornamental del espejo antiguo -->
        <StackPane>
            <!-- 1. Marco exterior con relieve y sombra pesada -->
            <Rectangle width="436" height="516" arcWidth="236" arcHeight="236" styleClass="espejo-marco-exterior"/>

            <!-- 2. Moldura intermedia acanalada -->
            <Rectangle width="406" height="486" arcWidth="216" arcHeight="216" styleClass="espejo-marco-relieve"/>

            <!-- 3. Encastre interior biselado -->
            <Rectangle width="386" height="466" arcWidth="202" arcHeight="202" styleClass="espejo-marco-interior"/>

            <!-- 4. Cristal de azogue oscuro -->
            <Rectangle fx:id="espejo" width="370" height="450" arcWidth="190" arcHeight="190" styleClass="espejo-cristal"/>

            <!-- Ojos espectrales interactivos que crecen con el tiempo -->
            <HBox fx:id="ojosEspejo" alignment="CENTER" spacing="50" mouseTransparent="true" styleClass="contenedor-ojos">
                <!-- Ojo izquierdo -->
                <StackPane>
                    <Ellipse radiusX="26" radiusY="14" styleClass="ojo-cuenca"/>
                    <Circle fx:id="pupilaIzquierda" radius="7" styleClass="ojo-pupila"/>
                </StackPane>
                <!-- Ojo derecho -->
                <StackPane>
                    <Ellipse radiusX="26" radiusY="14" styleClass="ojo-cuenca"/>
                    <Circle fx:id="pupilaDerecha" radius="7" styleClass="ojo-pupila"/>
                </StackPane>
            </HBox>

            <!-- 5. Reflejo de luz diagonal sobre el vidrio -->
            <Rectangle width="370" height="450" arcWidth="190" arcHeight="190" mouseTransparent="true" styleClass="espejo-brillo"/>

            <!-- 6. Texto susurrante centrado -->
            <Label fx:id="lblMensaje" styleClass="mensaje-espejo" wrapText="true" maxWidth="290" alignment="CENTER" mouseTransparent="true"/>
        </StackPane>

        <!-- Botón polivalente: Iniciar / Reintentar / Reiniciar sala -->
        <Button fx:id="btnIniciarJuego" text="Iniciar invocación" onAction="#empezarMinijuego" />

        <!-- Contenedor del código: oculto hasta completar el minijuego -->
        <VBox fx:id="panelCodigo" alignment="CENTER" spacing="15" visible="false" managed="false">
            <TextField fx:id="txtNumero" promptText="Introduce un número" maxWidth="310" onAction="#comprobar"/>
            <Button text="Responder" onAction="#comprobar"/>
        </VBox>
    </VBox>

    <!-- Capa para el orbe del minijuego -->
    <Pane fx:id="panelMinijuego" pickOnBounds="false" />

    <!-- Capas de jumpscare y letra final -->
    <ImageView fx:id="imgSusto" fitHeight="800" preserveRatio="true" visible="false">
        <image>
            <Image url="@img/susto.png"/>
        </image>
    </ImageView>
    <Label fx:id="lblLetra" styleClass="letra" visible="false" mouseTransparent="true"/>
</StackPane>